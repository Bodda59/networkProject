<!DOCTYPE html>
<html lang="en">

<head>
    <style>
        /* Global Styles */
        body {
            background: linear-gradient(to bottom, rgba(136, 6, 249, 0.8), rgba(0, 0, 0, 0.8)), url("background3.jpg");
            background-size: cover;
            background-attachment: fixed;
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 0;
            color: #fff;
            overflow-x: hidden;
            background: linear-gradient(135deg, #8505db 0%, #395ded 100%);
            color: #ffffff;
        }

        /* Navbar */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.7);
    padding: 20px 40px;
}

/* Search Bar */
.search-bar {
    display: flex;
    align-items: center;
    margin-left: auto; /* Align search bar to the right */
}

.search-bar input {
    padding: 10px;
    border: none;
    border-radius: 20px;
    outline: none;
    width: 200px;
    transition: width 0.3s ease-in-out;
}

.search-bar input:focus {
    width: 300px;
}

.search-bar button {
    background: #fa0254;
    color: white;
    border: none;
    padding: 10px 20px;
    margin-left: 10px;
    border-radius: 20px;
    cursor: pointer;
    transition: transform 0.2s ease;
}

.search-bar button:hover {
    transform: scale(1.1);
    background: #1c1114;
}

        
        .form-inline {
            display: flex;
            justify-content: flex-end;
            width: 100%;
        }

        .form-inline .form-control {
            background-color: rgba(255, 255, 255, 0.8);
            border-radius: 50px;
            padding: 15px;
            margin-right: 20px;
            font-size: 1.5rem; /* Increased font size */
            border: none;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.4);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            width: 300px; /* Adjust the width to fit the design */
        }

        .form-inline .form-control:focus {
            outline: none;
            transform: scale(1.05);
            box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.6);
        }

        .form-inline .btn {
            border-radius: 50px;
            background-color: #ff6f61;
            color: #fff;
            font-size: 1.5rem; /* Increased font size */
            padding: 15px 30px; /* Increased padding for bigger size */
            border: none;
            transition: background-color 0.3s ease, transform 0.3s ease;
        }

        .form-inline .btn:hover {
            background-color: #ff3b2f;
            transform: scale(1.1);
        }

        /* Heading */
        h1 {
            color: white;
            text-align: center;
            font-size: 3rem;
            text-transform: uppercase;
            text-shadow: 5px 5px 15px rgba(0, 0, 0, 0.6);
            margin-top: 60px;
            animation: fadeIn 2s ease-out;
        }

        /* Animations */
        @keyframes fadeIn {
            0% {
                opacity: 0;
            }

            100% {
                opacity: 1;
            }
        }

    
        /* Content Container */
.content-container {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    margin: 40px 0;
    animation: fadeIn 2s ease-out;
}
 
.video { 
    height: auto;
    aspect-ratio: 16 / 9; 
    border-radius: 15px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.7);
    transition: transform 0.3s ease;
}
.video iframe {
    width: 100%;
    height: 70%;
    border-radius: 15px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.7);
    transition: transform 0.3s ease;
    max-width: 100%; /* Ensures the iframe scales correctly */
    max-height: 100%; /* Ensures the iframe scales correctly */
}

/* Hover effect for video container */
.video:hover {
    transform: scale(1.05);
    box-shadow: 0px 12px 20px rgba(0, 0, 0, 0.7);
}
        .container1,
        .container2,
        .video {
            background-color: rgba(0, 0, 0, 0.6);
            border-radius: 20px;
            margin: 20px;
            padding: 20px;
            box-shadow: 0px 8px 15px rgba(0, 0, 0, 0.5);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            text-align: center;
            width: 30%;
            max-width: 480px;
            position: relative;
        }

        .container1 img {
            width: 100%;
            border-radius: 15px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.7);
        }

        .container2 p {
            font-size: 1.2rem;
            line-height: 1.8;
            color: #d1d1d1;
            animation: slideIn 1s ease-out;
        }

        @keyframes slideIn {
            0% {
                transform: translateY(30px);
                opacity: 0;
            }

            100% {
                transform: translateY(0);
                opacity: 1;
            }
        }

  

        .container1:hover,
        .container2:hover,
        .video:hover {
            transform: scale(1.05);
            box-shadow: 0px 12px 20px rgba(0, 0, 0, 0.7);
        }

        /* Want-to-Go Button Style */
        .wanttogo button {
            background-color: #ffac41;
            color: #fff;
            border: none;
            padding: 14px 28px;
            border-radius: 30px;
            font-size: 1.3rem;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.3s ease;
            box-shadow: 0px 8px 15px rgba(0, 0, 0, 0.3);
            margin-top: 20px;
        }

        .wanttogo button:hover {
            background-color: #ff8c00;
            transform: scale(1.1);
            box-shadow: 0px 12px 20px rgba(0, 0, 0, 0.5);
        }

        /* Scroll Effects */
        .scroll-section {
            position: relative;
            padding: 50px 0;
            background-color: rgba(0, 0, 0, 0.8);
        }

        .scroll-section h2 {
            font-size: 2.5rem;
            color: #ffac41;
            text-align: center;
            margin-bottom: 20px;
        }

       

        /* Return to Home Button */
        .return-home {
            position: fixed;
            top: 20px;
            left: 20px;
            z-index: 10;
        }
        
       
        .return-home button {
            background-color: #e90966;
            color: #fff;
            border: none;
            padding: 14px 28px;
            border-radius: 30px;
            font-size: 1.3rem;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.3s ease;
            box-shadow: 0px 8px 15px rgba(0, 0, 0, 0.3);
        }

        .return-home button:hover {
            background-color: #0f0c0a;
            transform: scale(1.1);
            box-shadow: 0px 12px 20px rgba(0, 0, 0, 0.5);
        }    
        .error-message {
            font-size: 20px;
            background-color: #150f0f;
            color: red;
            width: 25%;
            font-weight: bold;
            margin-left: 20px; 
            padding-left : 20px;
        }
    
        .success-message {
            font-size: 20px;
            background-color: #150f0f;
            color: rgb(10, 248, 110);
            width: 30%;
            font-weight: bold;
            margin-left: 20px; /* Adjust the value as needed */
            padding-left : 20px;
        }
        .success-message:hover {
            transform: scale(1.05);
            box-shadow: 0px 12px 20px rgba(0, 0, 0, 0.7);
        }
        .error-message:hover {
            transform: scale(1.05);
            box-shadow: 0px 12px 20px rgba(0, 0, 0, 0.7);
        }
        .custom-link {
            color: #ffac41; /* Change to any color you like */
            text-decoration: none; /* Removes underline */
            font-weight: bold; /* Optional, adds bold text */
        }
        
        .custom-link:hover {
            color: #f39c12; /* Color on hover */
            text-decoration: underline; /* Optional, adds underline on hover */
        }
    

    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Paris</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
</head>

<body>



   <!-- Return to Home Button -->
   <div class="return-home">
    <button onclick="window.location.href='/home'" class="navbar-toggler">Return to Home</button>
</div>

<!-- Navbar -->
<div class="navbar">
    <div class="search-bar">
        <form method="POST" action="/search">
            <input type="text" name="Search" placeholder="Search here..." />
            <button type="submit">Search</button>
        </form>
    </div>
</div>
    <h1>Explore the Magic of Paris</h1>

    <div class="content-container">
        <div class="container1">
            <img src="/paris.png" alt="Paris Image">
        </div>

        <div class="container2">
            <p>Paris, the most romantic city in the world, boasts stunning architecture, world-renowned museums, and enchanting streets. From the Eiffel Tower to the charming cafes, every corner of Paris has a story to tell. Ready to explore?</p>
        </div>


        <div class="video">
            <iframe width="1000" height="1000" src="https://www.youtube.com/embed/O98HEnCw0ek" 
            title="Exploring Paris, France | Iconic Landmarks & Parisian Charm #paris #france #travel #discover #europe" 
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            referrerpolicy="strict-origin-when-cross-origin" allowfullscreen>
            </iframe>
        
            <!-- Fallback content -->
            <noscript>
                <p>Sorry, we cannot load the video at the moment. Please ensure JavaScript is enabled or check back later.</p>
                <p>If you wish, you can also view the video on <a href="https://www.youtube.com/watch?v=O98HEnCw0ek" target="_blank">YouTube</a>.</p>
            </noscript>
        
            <!-- Alternative content in case the iframe does not load -->
            <div class="fallback-content">
                <p>Sorry, if the video could not be loaded. You can watch it on YouTube: 
                    <a href="https://www.youtube.com/watch?v=O98HEnCw0ek" target="_blank" class="custom-link">Watch on YouTube</a>.
                </p>
            </div>
        </div>
    </div>

    <div class="wanttogo">
        <form id="add-to-wanttogo-form">
            <input type="hidden" id="destination" name="destination" value="paris">
            <button type="submit" class="btn">Add to Want-to-Go</button>
        </form>
        <div><p></p></div>
        <div id="message-container"></div>
    </div>

    <script>
         // Handle registration form submission without page reload (AJAX)
         document.getElementById('add-to-wanttogo-form').addEventListener('submit', function(event) {
            event.preventDefault();

            const destination = document.getElementById('destination').value;
            // Clear previous messages before displaying new one
            const messageElement = document.getElementById('message-container');
            messageElement.classList.remove('success-message', 'error-message');
            messageElement.textContent = '';

            // AJAX request to the backend for registration
            fetch('/add-to-wanttogo', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ destination })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    messageElement.className = 'success-message';
                    messageElement.textContent = data.message;
                } else {
                    messageElement.className = 'error-message';
                    messageElement.textContent = data.message;
                }
            })
            .catch(error => {
                messageElement.className = 'error-message';
                messageElement.textContent = 'An unexpected error occurred. Please try again.';
            });
        });
    </script>
</body>

</html>