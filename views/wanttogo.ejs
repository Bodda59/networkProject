<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        body {
            background-image: url("background3.jpg");
            background-repeat: no-repeat;
            background-size: cover;
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #ef1717, #032328);
        }

        h1 {
            text-align: center;
            -webkit-text-stroke: 1px rgb(248, 11, 3);
            margin-top: 20px;
        }

        h1 {
            color: #f2f2f2;
            font-size: 2.5rem;
        }

        h2 {
            color: #d9d9d9;
            font-size: 2rem;
        }

        h3 {
            color: #d9d9d9;
            font-size: 2rem;
        }

        .navbar {
            background-color: rgba(0, 0, 0, 0.8);
        }

        .navbar-brand {
            color: #d1f7c4;
        }

        .form-inline .form-control {
            background-color: rgba(255, 255, 255, 0.8);
            border-radius: 50px;
            padding: 10px;
        }

        .form-inline .btn {
            background-color: #28a745;
            color: white;
            border-radius: 50px;
            padding: 10px 20px;
        }

        .container {
            padding: 50px;
        }

        .destination-list {
            list-style-type: none;
            padding: 0;
        }

        .destination-item {
            background-color: rgba(0, 0, 0, 0.7);
            padding: 15px;
            margin: 10px 0;
            border-radius: 10px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .destination-item:hover {
            transform: translateY(-10px);
            box-shadow: 0px 6px 15px rgba(0, 0, 0, 0.5);
        }

        .destination-item h3 {
            margin: 0;
            font-size: 1.5rem;
        }

        .destination-item .btn-delete {
            margin-top: 10px;
            background-color: #dc3545;
            color: white;
            border: none;
            border-radius: 5px;
            padding: 5px 10px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .destination-item .btn-delete:hover {
            background-color: #0e0c0c;
        }


         .btn-go {
            margin-top: 10px;
            background-color: #6705de;
            color: white;
            border: none;
            border-radius: 5px;
            padding: 5px 10px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .btn-go:hover {
            background-color: #0e0c0c;
        }

        .btn-home {
            background-color: #007bff;
            color: white;
            border-radius: 50px;
            padding: 10px 20px;
            text-align: center;
            display: block;
            margin: 30px auto;
            transition: background-color 0.3s ease;
            width: 250px;
        }

        .btn-home:hover {
            background-color: #1a1310;
        }
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Want-to-Go List</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <a class="navbar-brand">Want-to-Go List</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mr-auto"></ul>
            <form method="POST" action="/search" class="form-inline my-2 my-lg-0">
                <input class="form-control mr-sm-2" name="Search" type="search" placeholder="Search"
                    aria-label="Search">
                <button class="btn btn-outline-success my-2 my-sm-0" type="submit">Search</button>
            </form>
        </div>
    </nav>

    <div class="container">
        <h1>Welcome, <%= username %>!</h1>
        <h2>Your Want-to-Go Destinations</h2>

        <ul class="destination-list">
            <% if (destinations.length > 0) { %>
                <% destinations.forEach(function(destination, index) { %>
                    <li class="destination-item">
                        <h3><%= destination %></h3>
                        
                        <!-- Delete Form -->
                        <form method="POST" action="/delete-destination" style="display:inline;">
                            <input type="hidden" name="index" value="<%= index %>">
                            <button type="submit" class="btn-delete">Delete</button>
                        </form>
        
                        <!-- Redirect to Page -->
                        <button onclick="window.location.href='/<%= encodeURIComponent(destination) %>'" class="btn-go">Go to Page</button>
                    </li>
                <% }); %>
            <% } else { %>
                <li class="destination-item">
                    <p>You haven't added any destinations yet.</p>
                </li>
            <% } %>
        </ul>
        <!-- Return Home Button -->
        <a href="/home" class="btn-home">Return Home</a>
    </div>
</body>
</html>