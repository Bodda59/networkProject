<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        /* Global Styles */
        body {
            background-image: url("background3.jpg");
            background-repeat: no-repeat;
            background-size: cover;
            font-family: 'Roboto', sans-serif;
            margin: 0;
            padding: 0;
            color: #fff;
            background: linear-gradient(135deg, #d86182 0%, #1d2b64 100%);
            color: #ffffff;
        }

        h1 {
            color: #fff;
            text-align: center;
            text-shadow: 2px 2px 10px rgba(0, 0, 0, 0.7);
            margin-top: 40px;
            font-size: 3rem;
        }

        /* Navbar */
        .navbar {
            background-color: rgba(0, 0, 0, 0.8);
        }

        .navbar-brand {
            font-size: 24px;
            font-weight: bold;
            color: #f8f9fa !important;
        }

        /* Ensure the search bar and button are inline */
        .navbar .form-inline {
            display: flex;
            justify-content: flex-start; /* Align form elements to the left */
            align-items: center;
        }

        .navbar .form-control {
            border-radius: 50px;
            margin-right: 10px; /* Space between input and button */
        }

        .navbar .btn {
            border-radius: 50px;
        }

        /* Section Containers */
        .section {
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 40px 0;
            flex-wrap: wrap;
        }

        .container {
            background-color: rgba(0, 0, 0, 0.7);
            border-radius: 15px;
            padding: 20px;
            width: 250px;
            margin: 20px;
            box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.6);
            text-align: center;
            transition: transform 0.3s ease;
        }

        .container img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 10px;
        }

        .container:hover {
            transform: scale(1.05);
        }

        .container label {
            font-size: 1.4rem;
            font-weight: bold;
            margin-top: 15px;
            text-transform: uppercase;
        }

        .container p {
            font-size: 1rem;
            color: #d1d1d1;
            margin-top: 10px;
        }

        button {
            background-color: #007bff;
            color: #fff;
            border: none;
            padding: 10px;
            border-radius: 5px;
            font-size: 1.1rem;
            cursor: pointer;
            margin-top: 20px;
            transition: background-color 0.3s ease;
            width: 100%;
        }

        button:hover {
            background-color: #0056b3;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .section {
                flex-direction: column;
                align-items: center;
            }

            .container {
                width: 90%;
            }
        }
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Islands</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css"
        integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <a class="navbar-brand" href="#">Islands</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mr-auto"></ul>
            <form method="POST" action="/search" class="form-inline my-2 my-lg-0">
                <input class="form-control mr-sm-2" name="Search" type="search" placeholder="Search"
                    aria-label="Search">
                <button class="btn btn-outline-success my-2 my-sm-0" type="submit">Search</button>
            </form>
            
            <form method="GET" action="/home" style="margin-left: 10px;">
                <button class="btn btn-danger" type="submit">Return Home</button>
            </form>
        </div>
    </nav>

    <h1>Discover the World's Iconic Cities</h1>

    <div class="section">
        <div class="container">
            <img src="/bali.png" alt="Bali">
            <label>Bali</label>
            <p></p>
            <button onclick="location.href = '/bali';">Discover Bali</button>
        </div>
        <div class="container">
            <img src="/santorini.png" alt="Santorini">
            <label>Santorini</label>
            <p></p>
            <button onclick="location.href = '/santorini';">Explore Santorini</button>
        </div>
    </div>

</body>
</html>